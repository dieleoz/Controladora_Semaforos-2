{
  "enabledPlugins": {
    "orquestador@diego": true,
    "metodo@diego": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/decisiones_recordatorio.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUTF8": "1"
  }
}
